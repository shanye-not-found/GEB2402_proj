# Publish only runtime source, public product assets, tests and deployment tooling.
/*
!/.gitignore
!/.nvmrc
!/package.json
!/package-lock.json
!/index.html
!/tsconfig.json
!/vite.config.ts
!/src/
!/shared/
!/tests/

!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/deploy.yml

!/scripts/
/scripts/*
!/scripts/keys.mjs
!/scripts/decrypt.mjs

!/public/
/public/*
!/public/product-fallback.svg
!/public/products/
/public/products/*
!/public/products/*.webp
!/public/data/
/public/data/*
!/public/data/products.json
!/public/data/catalog-loader.mjs
!/public/data/export-key.json

# Documents, original screenshots, credentials and participant data stay local.
**/*.md
**/*.docx
**/*.pdf
**/*.xlsx
**/*.pem
**/*.geb2402
**/*.tsbuildinfo
**/__pycache__/
**/.DS_Store
